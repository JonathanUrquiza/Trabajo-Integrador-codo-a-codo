<%- include('../partials/headerS') %>
    <main class="container" id="register">
        <section class="register__header">
            <h1 class="register__title">CREA TU CUENTA</h1>
            <p class="register__subtitle">Completa el formulario para ser parte del mundo de los Funkos.</p>
        </section>

        <% if (locals.error) { %>
            <div class="alert alert-danger" role="alert">
                <%= error %>
            </div>
        <% } %>

        <form action="/auth/register" method="post" class="register__form" enctype="application/x-www-form-urlencoded">
            <fieldset class="form__box--grid">
                <label class="form__label" for="name">Nombre:</label>
                <input class="form__input" type="text" id="name" name="name" required placeholder="Nombre">
            </fieldset>
            <fieldset class="form__box--grid">
                <label for="lastname" class="form__label">Apellido:</label>
                <input type="text" class="form__input" id="lastname" name="lastname" required placeholder="Apellido">
            </fieldset>
            <fieldset class="form__box--grid">
                <label class="form__label" for="email">Email:</label>
                <input class="form__input" id="email" name="email" type="email" placeholder="example@email.com" required>
            </fieldset>
            <fieldset class="form__box--grid">
                <label class="form__label" for="password">Contraseña:</label>
                <input class="form__input" id="password" name="password" type="password" minlength="8" placeholder="Mínimo 8 caracteres" required>
            </fieldset>
            <fieldset class="form__box--grid">
                <label class="form__label" for="password_confirm">Repita contraseña:</label>
                <input class="form__input" id="password_confirm" name="password_confirm" type="password" minlength="8" placeholder="Repita su contraseña" required>
            </fieldset>
            <fieldset class="form__submission">
                <div class="form__terms">
                    <input type="checkbox" name="terms" id="terms" required>
                    <label for="terms">Acepto <a class="form__link" href="/faqs">Términos y condiciones</a></label>
                </div>
                <input class="form__btn btn btn--primary btn--large" type="submit" value="REGISTRAR">
                <a class="form__link" href="/auth/login">¿Ya tienes cuenta? Inicia sesión aquí</a>
            </fieldset>
        </form>

    </main>
    <%- include('../partials/footerS') %>