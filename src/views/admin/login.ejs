<%- include('../partials/headerS') %>
<main class="container" id="login">
    <h2 class="login__title">INGRESAR A MI CUENTA</h2>
    
    <% if (locals.error) { %>
        <div class="alert alert-danger" role="alert">
            <%= error %>
        </div>
    <% } %>
    
    <form class="login__form form" action="/auth/login" method="post">
      <div class="form__box--grid">
        <label class="form__label" for="email">Email:</label>
        <input class="form__input" type="email" name="email" id="email" placeholder="email@ejemplo.com" required>
      </div>
      <div class="form__box--grid">
        <label class="form__label" for="password">Contraseña:</label>
        <input class="form__input" type="password" name="password" id="password" placeholder="*******" required>
      </div>
      <div class="form__submission">
        <input class="form__btn btn btn--primary btn--large" type="submit" value="INGRESAR">
      </div>
      <div class="form__remember">
        <input type="checkbox" name="remember" id="remember">
        <label for="remember">Recordarme</label>
      </div>
      <a class="form__link" href="/auth/register">¿No tienes cuenta? Regístrate aquí</a>
    </form>
</main>
<%- include('../partials/footerS') %>